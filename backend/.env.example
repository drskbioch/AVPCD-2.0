# Copy to .env on the server and edit. Every value here is a placeholder; the API has no secrets.

# Release database, opened read-only. Local development default: analysis/phase6/release_v0.1/avpcd_v0.1.sqlite3 of this repository.
# On the server and in Docker, copy avpcd_v0.1.sqlite3 to this path.
AVPCD_DB_PATH=/data/avpcd_v0.1.sqlite3

# Exact browser origins allowed to call the API, comma-separated, no trailing slash. Empty = no CORS headers.
# Put the Vercel production URL (and the custom domain, if any) here. Vercel preview URLs change per deployment and are not allowed.
AVPCD_CORS_ORIGINS=https://your-project.vercel.app

# Paging limits.
AVPCD_DEFAULT_PAGE_SIZE=50
AVPCD_MAX_PAGE_SIZE=200

# /api/download serves the release tables as CSV. The site offers no downloads, so it is off.
AVPCD_ENABLE_DOWNLOAD=false

# Interactive API docs at /docs. Set false on a public server if you prefer.
AVPCD_ENABLE_DOCS=true

# Server process (start.sh). Defaults: HOST=127.0.0.1 (behind nginx on the same machine), PORT=8000, WEB_CONCURRENCY=2.
# The Docker image sets HOST=0.0.0.0 itself; do not set HOST here when you use --env-file with Docker.
# PORT=8000
# WEB_CONCURRENCY=2
