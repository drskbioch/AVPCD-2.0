# Sample systemd unit for running the API without Docker. Copy to /etc/systemd/system/avpcd-api.service,
# adjust the paths and user, then: systemctl daemon-reload && systemctl enable --now avpcd-api
[Unit]
Description=AVPCD API (read-only)
After=network.target

[Service]
User=avpcd
Group=avpcd
WorkingDirectory=/srv/avpcd/backend
EnvironmentFile=/srv/avpcd/backend/.env
ExecStart=/srv/avpcd/venv/bin/gunicorn app.main:app --worker-class uvicorn.workers.UvicornWorker --workers 2 --bind 127.0.0.1:8000 --timeout 30 --access-logfile -
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/srv/avpcd

[Install]
WantedBy=multi-user.target
